          "datasource": {
            "type": "influxdb",
            "uid": "glv-k6-influx"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE \"testid\" =~ /^$testid$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
