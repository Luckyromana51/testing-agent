        "label": "Test",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "glv-k6-influx"
        },
        "query": "SHOW TAG VALUES FROM \"http_reqs\" WITH KEY = \"testid\"",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "sort": 0
      }
    ]
  },
