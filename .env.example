# Optional: enables the Claude summary and fix suggestions on each report
ANTHROPIC_API_KEY=
# Model used for triage (defaults to claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
# How hard Claude thinks when writing a summary: low, medium (default), high or max. Lower uses fewer credits.
# A re-test that finds exactly the same issues reuses the last summary and uses no credits at all.
# CLAUDE_EFFORT=medium
# Only for running without Docker (Docker always uses port 4000 and /data inside the container)
# PORT=4000
# DATA_DIR=./data
# How many scans run at the same time
SCAN_CONCURRENCY=2
# Pages a website test opens at the same time, each with all its agents (1 to 16, default 4).
# The owner panel can change it too. Sites that answer "429 too many requests" drop to one page at a time.
# PARALLEL_PAGES=4
# Docker image processor type: linux/amd64 (default, servers and Apple Silicon via Rosetta)
# or linux/arm64 for ARM Linux servers
# DOCKER_PLATFORM=linux/amd64
# Login switch. 1 = login off: no owner account or sign-in, only for your own computer while building.
# docker compose uses 1 when this is not set. Change it to 0 before putting the system on a server.
AUTH_DISABLED=1
# Key that encrypts saved client logins (website sign-ins, API keys, Git tokens). Required on a server.
# Make one with: openssl rand -base64 32   Keep a copy: if it is lost, saved logins must be entered again.
# Without it, a key is made once and kept in the data folder (fine on your own computer).
# SECRET_KEY=
# Optional: create the owner account on first start without opening the dashboard
# OWNER_EMAIL=
# OWNER_PASSWORD=
# Set to 1 when running behind Nginx or Caddy, so secure cookies and client addresses work
# TRUST_PROXY=1
# Allow testing localhost and private network addresses (internal staging sites)
# ALLOW_PRIVATE_TARGETS=1
# Outside tools (tabs on the new-test page). Docker installs Lighthouse, the W3C HTML checker,
# testssl.sh, Nuclei, Schemathesis, Newman, Gitleaks, Opengrep, OSV-Scanner, Trivy, k6 and JMeter
# in the image, and runs OWASP ZAP next to it. k6, JMeter, ZAP's active scan and GLV's attack probes
# run only for a project with the client's written permission (see README.md).
# Key between the app and its ZAP container. Set your own random value on a server:
# ZAP_API_KEY=
# Tests started without a tool choice (the API, old projects) run every installed safe tool.
# Set to none to run only the platform's own checks unless tools are chosen.
# DEFAULT_TOOLS=none
# Without Docker: where the tools are, when they are not on PATH
# ZAP_URL=http://localhost:8080
# NUCLEI_PATH=/usr/local/bin/nuclei
# TESTSSL_PATH=/usr/bin/testssl
# GITLEAKS_PATH=/usr/local/bin/gitleaks
# OPENGREP_PATH=/usr/local/bin/opengrep
# OSV_SCANNER_PATH=/usr/local/bin/osv-scanner
# TRIVY_PATH=/usr/local/bin/trivy
# SCHEMATHESIS_PATH=/usr/local/bin/st
# NEWMAN_PATH=/usr/local/bin/newman
# K6_PATH=/usr/local/bin/k6
# JMETER_PATH=/opt/jmeter/bin/jmeter
# Folder of Opengrep rules (default: GLV's own rules in rules/opengrep)
# OPENGREP_RULES=./rules/opengrep
# Where Trivy keeps its vulnerability database (default: trivy-cache in the data folder)
# TRIVY_CACHE_DIR=
# 1 = Trivy uses the database it already has and does not update it (for servers without internet;
# copy a trivy-cache folder into TRIVY_CACHE_DIR first)
# TRIVY_OFFLINE=1
# 1 = OSV-Scanner checks packages against a local copy of the OSV database instead of asking osv.dev
# for each one (the copy is downloaded once into OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY)
# OSV_SCANNER_OFFLINE=1
# OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=
